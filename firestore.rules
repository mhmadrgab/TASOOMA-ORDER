rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null && request.auth.token.email != null; }
    // صاحب الحساب (محمد): الوحيد اللي بيدير الموظفين وبيدّي صلاحية "مدير كامل"
    function isOwner()    { return signedIn() && request.auth.token.email == 'mohamedrgab20@gmail.com'; }
    // المدير الكامل = صاحب الحساب، أو موظف مفعّل عليه admin=true في staff/{email}
    function isAdmin()    { return isOwner() || (isStaff() && staffDoc().get('admin', false) == true); }
    function isBranch()   { return signedIn() && request.auth.token.email.matches('^[0-9]{3}@tasooma[.]app$'); }
    function myCode()     { return request.auth.token.email.split('@')[0]; }
    function branchOn()   {
      return isBranch()
        && exists(/databases/$(database)/documents/branches/$(myCode()))
        && get(/databases/$(database)/documents/branches/$(myCode())).data.enabled == true;
    }

    function isDriver()   { return signedIn() && request.auth.token.email.matches('^drv[0-9]{1,2}@tasooma[.]app$'); }
    function myDrv()      { return request.auth.token.email.split('@')[0]; }
    function drvOn()      {
      return isDriver()
        && exists(/databases/$(database)/documents/drivers/$(myDrv()))
        && get(/databases/$(database)/documents/drivers/$(myDrv())).data.enabled == true;
    }

    // موظفو المستودع (محاسبين) بصلاحيات محددة: staff/{email} = {name, enabled, p:{req, cus, fl}}
    function staffDoc()   { return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data; }
    function isStaff()    {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email))
        && staffDoc().enabled == true;
    }
    function perm(k)      { return isStaff() && staffDoc().p.get(k, false) == true; }

    match /staff/{email} {
      allow read:  if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow write: if isOwner();
    }

    // حالة الفرع (مفعّل/معطّل): الفرع يقرأ حالته بس، والمستودع يتحكم
    match /branches/{code} {
      allow read:  if isAdmin() || (isBranch() && myCode() == code);
      allow write: if isAdmin();
    }

    // كلمات سر الفروع (للمستودع فقط، علشان يقدر يعيد إرسالها)
    match /secrets/{code} {
      allow read, write: if isAdmin();
    }

    // طلبات الفروع
    match /requests/{id} {
      function validNew() {
        let d = request.resource.data;
        return d.keys().hasOnly(['br','brn','no','dt','dr','gn','rows','codes','pcs','st','ts'])
          && d.keys().hasAll(['br','brn','no','dt','rows','codes','pcs','st','ts'])
          && d.br == myCode()
          && d.st == 'new'
          && d.rows is list && d.rows.size() > 0 && d.rows.size() <= 400
          && d.codes is number && d.pcs is number && d.pcs > 0 && d.pcs <= 100000
          && d.no is string && d.no.size() <= 40
          && d.brn is string && d.brn.size() <= 40
          && d.dt is string && d.dt.size() <= 12
          && (!('gn' in d) || (d.gn is string && d.gn.size() <= 1000))
          && (!('dr' in d) || (d.dr is string && d.dr.size() <= 100));
      }
      allow read:   if isAdmin() || (branchOn() && resource.data.br == myCode())
                    || perm('req') || perm('fl')
                    || (drvOn() && resource.data.asg.drv == myDrv());
      allow create: if isAdmin() || (branchOn() && validNew());
      // إثبات التسليم من السائق: اسم المستلم + توقيع + صورة (اختياري)
      function validPod() {
        let p = request.resource.data.pod;
        return p is map && p.keys().hasOnly(['name','sig','img','at'])
          && p.name is string && p.name.size() <= 60
          && (!('sig' in p) || (p.sig is string && p.sig.size() <= 40000))
          && (!('img' in p) || (p.img is string && p.img.size() <= 160000))
          && (!('at' in p) || p.at is number);
      }
      // مين جهّز الطلب (عمال المستودع): {by:[ids], names:[...], at}
      function validPrep() {
        let p = request.resource.data.prep;
        return p is map && p.keys().hasOnly(['by','names','at'])
          && p.by is list && p.by.size() <= 10
          && p.names is list && p.names.size() <= 10
          && p.at is number;
      }
      // تأكيد الاستلام من الفرع: بس لما الطلب يبقى "تم التسليم"، ويغيّر st و rcv بس
      function validRcv() {
        let r = request.resource.data.rcv;
        return r is map && r.keys().hasOnly(['at','ok','lines','note'])
          && r.at is number && r.ok is bool
          && r.lines is list && r.lines.size() <= 400
          && (!('note' in r) || (r.note is string && r.note.size() <= 500));
      }
      // المحادثة جوه الطلب: msgs = [{id, by, n, t, ts}]. مسموح بس "إضافة رسالة واحدة في الآخر":
      // الرسايل القديمة ماتتغيّرش ولا تتمسح، والرسالة الجديدة باسم الطرف اللي بيكتب (br = الفرع، wh = المستودع)
      function chatAdd(by) {
        let o = resource.data.get('msgs', []);
        let n = request.resource.data.get('msgs', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs'])
          && n is list && n.size() == o.size() + 1 && n.size() <= 200
          && n[o.size()] is map
          && n.removeAll([n[o.size()]]) == o
          && n[o.size()].keys().hasOnly(['id','by','n','t','ts'])
          && n[o.size()].keys().hasAll(['id','by','n','t','ts'])
          && n[o.size()].by == by
          && n[o.size()].id is string && n[o.size()].id.size() <= 30
          && n[o.size()].n is string && n[o.size()].n.size() <= 60
          && n[o.size()].t is string && n[o.size()].t.size() > 0 && n[o.size()].t.size() <= 500
          && n[o.size()].ts is number;
      }
      // الفرع يقدر يعيد إرسال نفس الطلب طالما لسه "جديد" (علشان ما يتكررش لو النت قطع)، أو يأكد الاستلام
      // السائق: يغيّر حالة الطلب المعيّن له بس (في الطريق / تم التسليم / رجوع للتجهيز)
      allow update: if isAdmin()
        || (perm('req') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','upd','rows','codes','pcs','gn','edited','eat','prep'])
            && (!('prep' in request.resource.data) || validPrep()))
        || (perm('req') && chatAdd('wh'))
        || (perm('fl') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asg','st','upd']))
        || (drvOn() && resource.data.asg.drv == myDrv()
            && resource.data.st in ['prep','go']
            && request.resource.data.st in ['prep','go','done']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','upd','dep','dlv','pod','eta'])
            && (!('pod' in request.resource.data) || validPod())
            && (!('eta' in request.resource.data) || request.resource.data.eta is number))
        || (branchOn() && resource.data.br == myCode() && (
          chatAdd('br')
          || (resource.data.st == 'new' && validNew())
          || (resource.data.st == 'done' && request.resource.data.st == 'recv'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','rcv'])
              && validRcv())
        ));
      allow delete: if isAdmin();
    }

    // عهدة المستودع وفواتيرها وإقفالاتها: للمستودع (الأدمن) فقط
    // المحاسب (perm cus): يقرأ ويسجّل ويعدّل حركات الفترة المفتوحة بس. الحذف والإقفال للمدير فقط.
    match /ledger/{id} {
      allow read:   if isAdmin() || perm('cus');
      allow create: if isAdmin() || (perm('cus') && !('sid' in request.resource.data));
      allow update: if isAdmin() || (perm('cus') && !('sid' in resource.data) && !('sid' in request.resource.data));
      allow delete: if isAdmin();
    }
    match /settlements/{id} {
      allow read:  if isAdmin() || perm('cus');
      allow write: if isAdmin();
    }

    // السواقين والسيارات والرحلات والبنزين
    match /drivers/{code} {
      allow read:  if isAdmin() || perm('fl') || (isDriver() && myDrv() == code);
      allow write: if isAdmin();
    }
    // عمال المستودع (أسماء بس، من غير حسابات): المدير يضيف ويعدّل، والمحاسب يقرأ علشان يختار مين جهّز
    match /workers/{id} {
      allow read:  if isAdmin() || perm('req') || perm('fl');
      allow write: if isAdmin();
    }
    // تقييم المدير الشهري للعمال (نجوم): wrate/{YYYY-MM} = {stars:{workerId: 1..5}}
    match /wrate/{mo} {
      allow read, write: if isAdmin();
    }
    // مواقع الفروع ومتوسط زمن الوصول (المستودع يحسبها، والسائق يقرأها)
    match /geo/{id} {
      allow read:  if isAdmin() || perm('fl') || drvOn();
      // كتابة واحدة بالكتير كل 10 دقايق، حتى لو صفحة قديمة فاتحة فيها خطأ بيكرر الكتابة (ده اللي خلّص الحصة اليومية)
      // (شرط الوقت الأول، علشان الطلب المرفوض مايعملش قراءة لصلاحيات المحاسب ويستهلك من الحصة)
      allow write: if request.resource.data.upd is number
        && request.resource.data.upd > request.time.toMillis() - 600000
        && request.resource.data.upd < request.time.toMillis() + 600000
        && (resource == null || request.time.toMillis() > resource.data.get('upd', 0) + 600000)
        && (isAdmin() || perm('fl'));
    }
    match /cars/{id} {
      allow read:  if isAdmin() || perm('fl') || drvOn();
      allow write: if isAdmin();
    }
    match /trips/{id} {
      function validTrip() {
        let d = request.resource.data;
        return d.keys().hasOnly(['drv','drvn','car','carn','st','start','odo0','stops','loc','loc0'])
          && d.keys().hasAll(['drv','drvn','car','carn','st','start','odo0','stops'])
          && d.drv == myDrv() && d.st == 'active'
          && d.start is number && d.odo0 is number && d.odo0 >= 0 && d.odo0 <= 9999999
          && d.stops is list && d.stops.size() <= 30
          && d.drvn is string && d.drvn.size() <= 60 && d.carn is string && d.carn.size() <= 60
          && d.car is string && d.car.size() <= 40;
      }
      allow read:   if isAdmin() || perm('fl') || (drvOn() && resource.data.drv == myDrv());
      allow create: if isAdmin() || (drvOn() && validTrip());
      allow update: if isAdmin()
        // المحاسب (perm fl) يقدر يقفل رحلة السائق نسي يقفلها
        || (perm('fl') && resource.data.st == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','end','odo1','note','forced'])
            && request.resource.data.st == 'done' && request.resource.data.forced == true
            && request.resource.data.odo1 is number && request.resource.data.odo1 >= resource.data.odo0 && request.resource.data.odo1 <= 9999999
            && request.resource.data.note is string && request.resource.data.note.size() <= 300)
        || (drvOn() && resource.data.drv == myDrv() && resource.data.st == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stops','loc','st','end','odo1','note'])
            && request.resource.data.st in ['active','done']
            && request.resource.data.stops is list && request.resource.data.stops.size() <= 30
            && (!('odo1' in request.resource.data) || (request.resource.data.odo1 is number && request.resource.data.odo1 >= resource.data.odo0 && request.resource.data.odo1 <= 9999999))
            && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300)));
      allow delete: if isAdmin();
    }
    match /fuel/{id} {
      function validFuel() {
        let d = request.resource.data;
        return d.keys().hasOnly(['drv','drvn','car','carn','ts','dt','liters','cost','odo','full'])
          && d.keys().hasAll(['drv','car','ts','dt','liters','cost','odo'])
          && d.drv == myDrv()
          && d.liters is number && d.liters > 0 && d.liters <= 500
          && d.cost is number && d.cost >= 0 && d.cost <= 100000
          && d.odo is number && d.odo >= 0 && d.odo <= 9999999
          && d.dt is string && d.dt.size() <= 12 && d.car is string && d.car.size() <= 40;
      }
      allow read:   if isAdmin() || perm('fl') || (drvOn() && resource.data.drv == myDrv());
      allow create: if isAdmin() || perm('fl') || (drvOn() && validFuel());
      allow update, delete: if isAdmin();
    }

    // شات الفروع مع المستودع: chats/{code}. كل فرع يقرا ويكتب في محادثته هو بس (الكود من إيميل الفرع نفسه)،
    // والمستودع = المدير أو موظف الطلبات (perm req). مفيش فرع يقدر يشوف أو يكتب في محادثة فرع تاني.
    match /chats/{code} {
      function chatWh() { return isAdmin() || perm('req'); }
      function chatBr() { return branchOn() && myCode() == code; }
      function lastOk(by) {
        let l = request.resource.data.last;
        return l is map && l.keys().hasOnly(['by','n','t','ts','v']) && l.keys().hasAll(['by','n','t','ts','v'])
          && l.by == by && l.n is string && l.n.size() <= 60
          && l.t is string && l.t.size() <= 200 && l.ts is number && l.v is bool;
      }
      function brnOk(d) { return !('brn' in d) || (d.brn is string && d.brn.size() <= 40); }
      // أول رسالة في المحادثة
      function newBy(by) {
        let d = request.resource.data;
        return d.br == code && brnOk(d) && lastOk(by)
          && ((by == 'br' && d.keys().hasOnly(['br','brn','last','lb','rb','nw']) && d.nw == 1 && d.lb is number && d.rb is number)
           || (by == 'wh' && d.keys().hasOnly(['br','brn','last','lw','rw','nb']) && d.nb == 1 && d.lw is number && d.rw is number));
      }
      // رسالة جديدة (العدّاد بيزيد واحد بالظبط) أو "قريت" (العدّاد بيرجع صفر)
      function updBy(by) {
        let d = request.resource.data;
        let o = resource.data;
        let ch = d.diff(o).affectedKeys();
        return d.br == code && brnOk(d)
          && (!('last' in ch) || lastOk(by))
          && ((by == 'br' && ch.hasOnly(['brn','last','lb','rb','nw','nb'])
               && (!('nw' in ch) || d.nw == o.get('nw', 0) + 1)
               && (!('nb' in ch) || d.nb == 0)
               && (!('lb' in ch) || d.lb is number) && (!('rb' in ch) || d.rb is number))
           || (by == 'wh' && ch.hasOnly(['brn','last','lw','rw','nb','nw'])
               && (!('nb' in ch) || d.nb == o.get('nb', 0) + 1)
               && (!('nw' in ch) || d.nw == 0)
               && (!('lw' in ch) || d.lw is number) && (!('rw' in ch) || d.rw is number)));
      }
      allow read:   if chatWh() || chatBr();
      allow create: if (chatBr() && newBy('br')) || (chatWh() && newBy('wh'));
      allow update: if (chatBr() && updBy('br')) || (chatWh() && updBy('wh'));
      allow delete: if isAdmin();

      // الرسايل: نص (t) أو صوت (v + d = المدة بالثواني). محدش يعدّل رسالة بعد ما تتبعت
      match /msgs/{mid} {
        function msgOk(by) {
          let d = request.resource.data;
          return d.keys().hasOnly(['by','n','t','v','d','ts']) && d.keys().hasAll(['by','n','ts'])
            && d.by == by && d.n is string && d.n.size() <= 60 && d.ts is number
            && ((d.keys().hasAll(['t']) && !('v' in d) && d.t is string && d.t.size() > 0 && d.t.size() <= 1000)
             || (d.keys().hasAll(['v','d']) && !('t' in d) && d.v == true && d.d is number && d.d > 0 && d.d <= 120));
        }
        allow read:   if chatWh() || chatBr();
        allow create: if (chatBr() && msgOk('br')) || (chatWh() && msgOk('wh'));
        allow delete: if isAdmin();
      }
      // الصوت نفسه (data URL صوت بس، أقصى حوالي 500 كيلو)
      match /aud/{mid} {
        allow read:   if chatWh() || chatBr();
        allow create: if (chatWh() || chatBr())
          && request.resource.data.keys().hasOnly(['a'])
          && request.resource.data.a is string && request.resource.data.a.size() <= 700000
          && request.resource.data.a.matches('data:audio/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=]+');
        allow delete: if isAdmin();
      }
    }

    // أجهزة إشعارات الموبايل: كل جهاز بيسجّل نفسه باسم صاحبه بس (السيرفر بيقرا بصلاحياته الخاصة)
    // push/{role__token}: نفس الموبايل ممكن يتسجّل بأكتر من دور (مستودع + فرع على نفس الجهاز)
    match /push/{pid} {
      function okPush() {
        let d = request.resource.data;
        return d.keys().hasOnly(['role','key','email','ts','tok'])
          && d.email == request.auth.token.email && d.ts is number && d.key is string && d.key.size() <= 120
          && d.tok is string && d.tok.size() <= 400 && pid == d.role + '__' + d.tok
          && ((d.role == 'branch' && isBranch() && d.key == myCode())
            || (d.role == 'driver' && isDriver() && d.key == myDrv())
            || (d.role == 'staff' && !isBranch() && !isDriver() && d.key == request.auth.token.email));
      }
      allow create, update: if signedIn() && okPush();
      allow delete: if signedIn() && resource.data.email == request.auth.token.email;
    }

    // أي حاجة تانية ممنوعة
  }
}
