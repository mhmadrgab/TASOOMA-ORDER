rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null && request.auth.token.email != null; }
    // صاحب الحساب (محمد): الوحيد اللي بيدير الموظفين وبيدّي صلاحية "مدير كامل"
    function isOwner()    { return signedIn() && request.auth.token.email == 'mohamedrgab20@gmail.com'; }
    // المدير الكامل = صاحب الحساب، أو موظف مفعّل عليه admin=true في staff/{email}
    function isAdmin()    { return isOwner() || (isStaff() && staffDoc().get('admin', false) == true); }
    function isBranch()   { return signedIn() && request.auth.token.email.matches('^[0-9]{3}@tasooma[.]app$'); }
    function myCode()     { return request.auth.token.email.split('@')[0]; }
    function branchOn()   {
      return isBranch()
        && exists(/databases/$(database)/documents/branches/$(myCode()))
        && get(/databases/$(database)/documents/branches/$(myCode())).data.enabled == true;
    }

    function isDriver()   { return signedIn() && request.auth.token.email.matches('^drv[0-9]{1,2}@tasooma[.]app$'); }
    function myDrv()      { return request.auth.token.email.split('@')[0]; }
    function drvOn()      {
      return isDriver()
        && exists(/databases/$(database)/documents/drivers/$(myDrv()))
        && get(/databases/$(database)/documents/drivers/$(myDrv())).data.enabled == true;
    }

    // موظفو المستودع (محاسبين) بصلاحيات محددة: staff/{email} = {name, enabled, p:{req, cus, fl}}
    function staffDoc()   { return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data; }
    function isStaff()    {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email))
        && staffDoc().enabled == true;
    }
    function perm(k)      { return isStaff() && staffDoc().p.get(k, false) == true; }
    // "متابع" (صاحب الشركة): staff/{email}.v = true. بيقرا كل حاجة (من غير كلمات السر والشات الخاص) ومايقدرش يكتب أي حاجة
    function isViewer()   { return isStaff() && staffDoc().get('v', false) == true; }

    match /staff/{email} {
      allow read:  if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow write: if isOwner();
      // 🔑 المدير اللي المالك اداله "إدارة صلاحيات المحاسبين" (p.pm): يغيّر صلاحيات المحاسبين بس
      // (الطلبات/العهدة/السيارات/الهدايا) ومايلمسش مدير ولا متابع ولا مدير تسويق ولا نفسه ولا أي حقل تاني
      allow update: if isAdmin() && perm('pm') && email != request.auth.token.email.lower()
        && resource.data.get('admin', false) != true && resource.data.get('v', false) != true
        && resource.data.get('p', {}).get('gm', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p'])
        && request.resource.data.p.diff(resource.data.get('p', {})).affectedKeys().hasOnly(['req','cus','fl','gift'])
        && request.resource.data.p.get('req', false) is bool && request.resource.data.p.get('cus', false) is bool
        && request.resource.data.p.get('fl', false) is bool && request.resource.data.p.get('gift', false) is bool;
    }

    // حالة الفرع (مفعّل/معطّل): الفرع يقرأ حالته بس، والمستودع يتحكم
    match /branches/{code} {
      allow read:  if isAdmin() || isViewer() || (isBranch() && myCode() == code);
      allow write: if isAdmin();
    }

    // كلمات سر الفروع (للمستودع فقط، علشان يقدر يعيد إرسالها)
    match /secrets/{code} {
      allow read, write: if isAdmin();
    }

    // طلبات الفروع
    match /requests/{id} {
      function validNew() {
        let d = request.resource.data;
        return d.keys().hasOnly(['br','brn','no','dt','dr','gn','rows','codes','pcs','st','ts'])
          && d.br == myCode() && bodyOk(d);
      }
      // طلب عمله المستودع للفرع (من الورقة اليدوية): نفس شكل طلب الفرع + by='wh' واسم اللي عمله (byn)
      // تحويل بين فرعين: نفس الطلب باسم الفرع اللي هيستلم (br) + tr = {fr: الفرع اللي هيجهّز ويبعت, frn}
      function validWh() {
        let d = request.resource.data;
        return d.keys().hasOnly(['br','brn','no','dt','dr','gn','rows','codes','pcs','st','ts','by','byn','tr'])
          && d.keys().hasAll(['by'])
          && d.by == 'wh' && d.br is string && d.br.matches('^[0-9]{3}$') && d.brn.matches(d.br + '-.*')
          && (!('byn' in d) || (d.byn is string && d.byn.size() <= 60))
          && (!('tr' in d) || (d.tr is map && d.tr.keys().hasOnly(['fr','frn']) && d.tr.fr is string && d.tr.fr.matches('^[0-9]{3}$')
               && d.tr.fr != d.br && d.tr.frn is string && d.tr.frn.size() <= 40))
          && bodyOk(d);
      }
      function bodyOk(d) {
        return d.keys().hasAll(['br','brn','no','dt','rows','codes','pcs','st','ts'])
          && d.st == 'new'
          && d.rows is list && d.rows.size() > 0 && d.rows.size() <= 400
          && d.codes is number && d.pcs is number && d.pcs > 0 && d.pcs <= 100000
          && d.no is string && d.no.size() <= 40
          && d.brn is string && d.brn.size() <= 40
          && d.dt is string && d.dt.size() <= 12
          && (!('gn' in d) || (d.gn is string && d.gn.size() <= 1000))
          && (!('dr' in d) || (d.dr is string && d.dr.size() <= 100));
      }
      // الفرع اللي هيبعت تحويل (tr.fr) بيشوفه كمان علشان يجهّزه
      allow read:   if isAdmin() || (branchOn() && resource.data.br == myCode())
                    || perm('req') || perm('fl') || isViewer()
                    || (branchOn() && resource.data.tr.fr == myCode())
                    || (drvOn() && resource.data.asg.drv == myDrv());
      allow create: if isAdmin() || (branchOn() && validNew()) || (perm('req') && validWh());
      // إثبات التسليم من السائق: اسم المستلم + توقيع + صورة (اختياري)
      function validPod() {
        let p = request.resource.data.pod;
        // (ph/sg = فيه صورة/توقيع في pods/{id}. الصور الجديدة مابقتش جوه الطلب، والقديمة لسه مسموحة)
        return p is map && p.keys().hasOnly(['name','sig','img','at','ph','sg','wb','co'])
          && (!('wb' in p) || (p.wb is string && p.wb.size() <= 40)) && (!('co' in p) || (p.co is string && p.co.size() <= 60))
          && (!('ph' in p) || p.ph == 1) && (!('sg' in p) || p.sg == 1)
          && p.name is string && p.name.size() <= 60
          && (!('sig' in p) || (p.sig is string && p.sig.size() <= 40000))
          && (!('img' in p) || (p.img is string && p.img.size() <= 160000))
          && (!('at' in p) || p.at is number);
      }
      // مين جهّز الطلب (عمال المستودع): {by:[ids], names:[...], at}
      function validPrep() {
        let p = request.resource.data.prep;
        return p is map && p.keys().hasOnly(['by','names','at'])
          && p.by is list && p.by.size() <= 10
          && p.names is list && p.names.size() <= 10
          && p.at is number;
      }
      // تأكيد الاستلام من الفرع: بس لما الطلب يبقى "تم التسليم"، ويغيّر st و rcv بس
      function validRcv() {
        let r = request.resource.data.rcv;
        return r is map && r.keys().hasOnly(['at','ok','lines','note'])
          && r.at is number && r.ok is bool
          && r.lines is list && r.lines.size() <= 400
          && (!('note' in r) || (r.note is string && r.note.size() <= 500));
      }
      // (المحادثة اللي كانت جوه الطلب نفسه اتشالت: كل الشات بقى خاص في dm تحت)
      // الفرع يقدر يعيد إرسال نفس الطلب طالما لسه "جديد" (علشان ما يتكررش لو النت قطع)، أو يأكد الاستلام
      // السائق: يغيّر حالة الطلب المعيّن له بس (في الطريق / تم التسليم / رجوع للتجهيز)
      // إثبات التسليم (الصورة والتوقيع): المالك بس يقدر يمسحه أو يغيّره (المديرين يعدّلوا أي حاجة تانية في الطلب عادي)
      // الطلب اللي الفرع أكّد استلامه (recv) حالته ماتتغيّرش تاني (علشان محدش "يعيد فتحه" وبعدين يمسحه)
      allow update: if (resource.data.get('st', '') != 'recv' || request.resource.data.get('st', '') == 'recv') && (
        (isAdmin() && (isOwner() || request.resource.data.get('pod', null) == resource.data.get('pod', null)))
        || (perm('req') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','upd','rows','codes','pcs','gn','edited','eat','edn','prep','pdn'])
            && (!('prep' in request.resource.data) || validPrep())
            && (!('pdn' in request.resource.data) || request.resource.data.pdn is number))
        || (perm('fl') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asg','st','upd']))
        || (drvOn() && resource.data.asg.drv == myDrv()
            && resource.data.st in ['prep','go']
            && request.resource.data.st in ['prep','go','done']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','upd','dep','dlv','pod','eta','pk','near'])
            && (!('pod' in request.resource.data) || validPod())
            && (!('pk' in request.resource.data) || request.resource.data.pk is number)
            && (!('near' in request.resource.data) || request.resource.data.near is number)
            && (!('eta' in request.resource.data) || request.resource.data.eta is number))
        // التحويل: الفرع اللي هيبعت يقول "بدأت أجهّز" (new ← prep) و"جاهزة للسواق" (rdy) بس
        || (branchOn() && resource.data.get('tr', {}).get('fr', '') == myCode()
            && resource.data.st in ['new','prep'] && request.resource.data.st in ['new','prep']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','upd','rdy'])
            && (!('rdy' in request.resource.data) || request.resource.data.rdy is number))
        || (branchOn() && resource.data.br == myCode() && (
          (resource.data.st == 'new' && validNew())
          || (resource.data.st == 'done' && request.resource.data.st == 'recv'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','rcv'])
              && validRcv())
        )));
      // الطلب اللي الفرع أكّد استلامه (recv): المالك بس يقدر يمسحه (طلب محمد، نوفمبر 2026). المديرين لأ
      allow delete: if isOwner() || (isAdmin() && resource.data.st != 'recv');
    }

    // صورة التسليم وتوقيع المستلم: pods/{رقم الطلب} = {img?, sig?, at, drv}. لوحدها علشان الطلبات تفضل خفيفة
    // (بتتقري بس لما حد يدوس "صورة التسليم"). السائق المعيّن يكتبها وهو بيسلّم، والمسح/التعديل للمالك بس.
    match /pods/{rid} {
      function podReq() { return get(/databases/$(database)/documents/requests/$(rid)).data; }
      function validPics() {
        let d = request.resource.data;
        return d.keys().hasOnly(['img','sig','at','drv']) && d.at is number && d.drv == myDrv()
          && (!('img' in d) || (d.img is string && d.img.size() <= 160000))
          && (!('sig' in d) || (d.sig is string && d.sig.size() <= 40000));
      }
      allow read: if isAdmin() || perm('req') || perm('fl') || isViewer();
      allow create, update: if isOwner()
        || (drvOn() && podReq().asg.drv == myDrv() && podReq().st in ['prep','go'] && validPics());
      allow delete: if isOwner();
    }

    // 🎁 الهدايا والعينات (gifts.js): الفرع بيسجّل (مستنية اعتماد)، والمستودع/المديرين بيعتمدوا أو يرفضوا،
    // والمحاسب (perm gift) والمتابع بيشوفوا بس. هدايا المستودع نفسه بتستنى الاعتماد زي الفروع. التعديل والحذف لمالك النظام بس.
    match /gifts/{id} {
      function giftOk(d) {
        return d.keys().hasOnly(['br','brn','no','ts','dt','rows','pcs','to','why','note','img','by','st','ap'])
          && d.keys().hasAll(['br','brn','no','ts','dt','rows','pcs','to','why','by','st'])
          && d.rows is list && d.rows.size() > 0 && d.rows.size() <= 100
          && d.pcs is number && d.pcs > 0 && d.pcs <= 100000
          && d.to is map && d.to.keys().hasOnly(['n','ph']) && d.to.n is string && d.to.n.size() > 0 && d.to.n.size() <= 60
          && (!('ph' in d.to) || (d.to.ph is string && d.to.ph.size() <= 20))
          && d.why is string && d.why.size() <= 40
          && (!('note' in d) || (d.note is string && d.note.size() <= 300))
          && (!('img' in d) || d.img == 1) && d.ts is number && d.dt is string && d.dt.size() <= 12
          && d.no is string && d.no.size() <= 40 && d.brn is string && d.brn.size() <= 40
          && d.by is map && d.by.keys().hasOnly(['e','n']) && d.by.e == request.auth.token.email.lower()
          && d.by.n is string && d.by.n.size() > 0 && d.by.n.size() <= 60;
      }
      function apOk(a) {
        return a is map && a.keys().hasOnly(['e','n','at','note']) && a.e == request.auth.token.email.lower()
          && a.at is number && a.n is string && a.n.size() <= 60
          && (!('note' in a) || (a.note is string && a.note.size() <= 300));
      }
      // الاعتماد (نوفمبر 2026، طلب محمد): مدير التسويق (gm) واللي المالك اداله "اعتماد الهدايا" (ga) بس.
      // المستودع (المديرين وصلاحية الطلبات) بيسجّل هدايا المستودع، وبتروح بانتظار الاعتماد زي الفروع
      function approver() { return perm('gm') || perm('ga'); }
      function recorder() { return isAdmin() || perm('req'); }
      // المحاسب (gift) بيشوف المعتمد بس (ok = مستني تسوية، set = اتسوّى)، مش اللي لسه بانتظار الاعتماد أو المرفوض
      allow read: if approver() || recorder() || isViewer() || (branchOn() && resource.data.br == myCode())
                  || (perm('gift') && resource.data.st in ['ok','set']);
      allow create: if (branchOn() && giftOk(request.resource.data) && request.resource.data.br == myCode()
                        && request.resource.data.st == 'pend' && !('ap' in request.resource.data))
                    || (recorder() && giftOk(request.resource.data) && request.resource.data.br == 'WH'
                        && request.resource.data.st == 'pend' && !('ap' in request.resource.data));
      allow update: if isOwner()
        || (approver() && resource.data.st == 'pend' && request.resource.data.st in ['ok','no']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','ap','rt'])
            && (!('rt' in request.resource.data) || request.resource.data.rt is bool)
            && apOk(request.resource.data.ap))
        // رجوع العينة (rt = true): اللي طلّعها يسجّل اللي رجع (الفرع لهداياه، والمستودع لهدايا المستودع)، مرة واحدة وقبل التسوية
        || (resource.data.st == 'ok' && resource.data.get('rt', false) == true && !('rb' in resource.data)
            && ((branchOn() && resource.data.br == myCode()) || (recorder() && resource.data.br == 'WH'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rb'])
            && request.resource.data.rb is map && request.resource.data.rb.keys().hasOnly(['e','n','at','q','lines','note'])
            && request.resource.data.rb.e == request.auth.token.email.lower() && request.resource.data.rb.at is number
            && request.resource.data.rb.n is string && request.resource.data.rb.n.size() > 0 && request.resource.data.rb.n.size() <= 60
            && request.resource.data.rb.q is number && request.resource.data.rb.q > 0 && request.resource.data.rb.q <= resource.data.pcs
            && request.resource.data.rb.lines is list && request.resource.data.rb.lines.size() <= 100
            && (!('note' in request.resource.data.rb) || (request.resource.data.rb.note is string && request.resource.data.rb.note.size() <= 200)))
        // التسوية: المحاسب (أو المدير) كتب رقم/مرجع السند في السيستم بعد ما خصم الهدية من مخزون الفرع
        || ((perm('gift') || isAdmin()) && resource.data.st == 'ok' && request.resource.data.st == 'set'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','sa','sm'])
            && request.resource.data.sm is string && request.resource.data.sm.size() == 7
            && request.resource.data.sa is map && request.resource.data.sa.keys().hasOnly(['e','n','at','ref','net'])
            && (!('net' in request.resource.data.sa) || request.resource.data.sa.net is number)
            && request.resource.data.sa.e == request.auth.token.email.lower() && request.resource.data.sa.at is number
            && request.resource.data.sa.n is string && request.resource.data.sa.n.size() <= 60
            && request.resource.data.sa.ref is string && request.resource.data.sa.ref.size() > 0 && request.resource.data.sa.ref.size() <= 60);
      allow delete: if isOwner();
    }
    // صورة سند الهدية لوحدها (giftimg/{نفس رقم الهدية}) بتتكتب مع الهدية في نفس المرة
    match /giftimg/{id} {
      allow read: if isAdmin() || perm('req') || perm('gm') || perm('ga') || isViewer()
        || (perm('gift') && get(/databases/$(database)/documents/gifts/$(id)).data.st in ['ok','set'])
        || (branchOn() && get(/databases/$(database)/documents/gifts/$(id)).data.br == myCode());
      allow create: if request.resource.data.keys().hasOnly(['img']) && request.resource.data.img is string
        && request.resource.data.img.size() <= 300000
        && ((branchOn() && getAfter(/databases/$(database)/documents/gifts/$(id)).data.br == myCode())
            || ((isAdmin() || perm('req')) && getAfter(/databases/$(database)/documents/gifts/$(id)).data.br == 'WH')
            || isOwner());
      allow update, delete: if isOwner();
    }

    // عهدة المستودع وفواتيرها وإقفالاتها: للمستودع (الأدمن) فقط
    // المحاسب (perm cus): يقرأ ويسجّل ويعدّل حركات الفترة المفتوحة بس. الحذف والإقفال للمدير فقط.
    match /ledger/{id} {
      allow read:   if isAdmin() || perm('cus') || isViewer();
      allow create: if isAdmin() || (perm('cus') && !('sid' in request.resource.data));
      // صورة الفاتورة: لو موجودة، المالك بس يقدر يمسحها أو يبدّلها
      allow update: if (isAdmin() || (perm('cus') && !('sid' in resource.data) && !('sid' in request.resource.data)))
        && (isOwner() || resource.data.get('img', '') == '' || request.resource.data.get('img', '') == resource.data.get('img', ''));
      allow delete: if isAdmin();
    }
    match /settlements/{id} {
      allow read:  if isAdmin() || perm('cus') || isViewer();
      allow write: if isAdmin();
    }

    // السواقين والسيارات والرحلات والبنزين
    match /drivers/{code} {
      allow read:  if isAdmin() || perm('fl') || isViewer() || (isDriver() && myDrv() == code);
      allow write: if isAdmin();
      // السائق يعمل رمز التتبع بتاعه بنفسه (تطبيق TASOOMA / Traccar) لو لسه مالوش رمز. مايقدرش يغيّر أي حاجة تانية
      allow update: if isDriver() && myDrv() == code
        && (!('gps' in resource.data) || resource.data.gps == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gps'])
        && request.resource.data.gps is string && request.resource.data.gps.matches('[A-Za-z0-9]{24,40}');
    }
    // عمال المستودع (أسماء بس، من غير حسابات): المدير يضيف ويعدّل، والمحاسب يقرأ علشان يختار مين جهّز
    match /workers/{id} {
      allow read:  if isAdmin() || perm('req') || perm('fl') || isViewer();
      allow write: if isAdmin();
    }
    // تقييم المدير الشهري للعمال (نجوم): wrate/{YYYY-MM} = {stars:{workerId: 1..5}}
    match /wrate/{mo} {
      allow read:  if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    // مواقع الفروع ومتوسط زمن الوصول (المستودع يحسبها، والسائق يقرأها)
    match /geo/{id} {
      allow read:  if isAdmin() || perm('fl') || isViewer() || drvOn();
      // كتابة واحدة بالكتير كل 10 دقايق، حتى لو صفحة قديمة فاتحة فيها خطأ بيكرر الكتابة (ده اللي خلّص الحصة اليومية)
      // (شرط الوقت الأول، علشان الطلب المرفوض مايعملش قراءة لصلاحيات المحاسب ويستهلك من الحصة)
      allow write: if request.resource.data.upd is number
        && request.resource.data.upd > request.time.toMillis() - 600000
        && request.resource.data.upd < request.time.toMillis() + 600000
        && (resource == null || request.time.toMillis() > resource.data.get('upd', 0) + 600000)
        && (isAdmin() || perm('fl'));
    }
    match /cars/{id} {
      allow read:  if isAdmin() || perm('fl') || isViewer() || drvOn();
      allow write: if isAdmin();
    }
    match /trips/{id} {
      function validTrip() {
        let d = request.resource.data;
        return d.keys().hasOnly(['drv','drvn','car','carn','st','start','odo0','stops','loc','loc0'])
          && d.keys().hasAll(['drv','drvn','car','carn','st','start','odo0','stops'])
          && d.drv == myDrv() && d.st == 'active'
          && d.start is number && d.odo0 is number && d.odo0 >= 0 && d.odo0 <= 9999999
          && d.stops is list && d.stops.size() <= 30
          && d.drvn is string && d.drvn.size() <= 60 && d.carn is string && d.carn.size() <= 60
          && d.car is string && d.car.size() <= 40;
      }
      allow read:   if isAdmin() || perm('fl') || isViewer() || (drvOn() && resource.data.drv == myDrv());
      allow create: if isAdmin() || (drvOn() && validTrip());
      allow update: if isAdmin()
        // المحاسب (perm fl) يقدر يقفل رحلة السائق نسي يقفلها
        || (perm('fl') && resource.data.st == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','end','odo1','note','forced'])
            && request.resource.data.st == 'done' && request.resource.data.forced == true
            && request.resource.data.odo1 is number && request.resource.data.odo1 >= resource.data.odo0 && request.resource.data.odo1 <= 9999999
            && request.resource.data.note is string && request.resource.data.note.size() <= 300)
        || (drvOn() && resource.data.drv == myDrv() && resource.data.st == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stops','loc','st','end','odo1','note'])
            && request.resource.data.st in ['active','done']
            && request.resource.data.stops is list && request.resource.data.stops.size() <= 30
            && (!('odo1' in request.resource.data) || (request.resource.data.odo1 is number && request.resource.data.odo1 >= resource.data.odo0 && request.resource.data.odo1 <= 9999999))
            && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300)));
      allow delete: if isAdmin();
    }
    match /fuel/{id} {
      function validFuel() {
        let d = request.resource.data;
        return d.keys().hasOnly(['drv','drvn','car','carn','ts','dt','liters','cost','odo','full'])
          && d.keys().hasAll(['drv','car','ts','dt','liters','cost','odo'])
          && d.drv == myDrv()
          && d.liters is number && d.liters > 0 && d.liters <= 500
          && d.cost is number && d.cost >= 0 && d.cost <= 100000
          && d.odo is number && d.odo >= 0 && d.odo <= 9999999
          && d.dt is string && d.dt.size() <= 12 && d.car is string && d.car.size() <= 40;
      }
      allow read:   if isAdmin() || perm('fl') || isViewer() || (drvOn() && resource.data.drv == myDrv());
      allow create: if isAdmin() || perm('fl') || (drvOn() && validFuel());
      allow update, delete: if isAdmin();
    }

    // الشات القديم المشترك (chats/{code}): اتقفل. المالك بس يقدر يقرا ويمسح (علشان المسح مرة واحدة من اللوحة)
    match /chats/{code} {
      allow read, delete: if isOwner();
      match /{sub}/{mid} {
        allow read, delete: if isOwner();
      }
    }

    // أسماء اللي في المستودع (الفرع بيختار يكلّم مين): whdir/{email} = {n: الاسم, k: الكنية, r: owner|admin|req}
    // المالك بس بيكتبها (staff.js بيظبطها لوحده من تبويب الموظفين)
    // r = owner/admin/req (بيكلّموا الفروع) أو staff (موظف تاني: بيكلّم السواقين والموظفين بس)
    match /whdir/{em} {
      allow read:  if isAdmin() || isStaff() || branchOn() || drvOn();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['n','k','r','w'])
        && (!('w' in request.resource.data) || request.resource.data.w is bool)
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && (!('k' in request.resource.data) || (request.resource.data.k is string && request.resource.data.k.size() <= 40))
        && request.resource.data.r in ['owner','admin','req','staff','gm','v'];// gm مدير التسويق، v صاحب الشركة (قسم الإدارة في الشات)
      allow delete: if isOwner();
    }
    // الفروع اللي خارج الرياض: ship/main = {c:{كود الفرع: اسم شركة الشحن}}. المدير بيكتبها من تبويب الفروع، والباقي بيقرا
    // (السواق بيسلّم لشركة الشحن بدل الفرع، والفرع بيعرض حالة الطلب على كده)
    match /ship/{id} {
      allow read:  if isAdmin() || isStaff() || branchOn() || drvOn();
      allow write: if isAdmin() && id == 'main' && request.resource.data.keys().hasOnly(['c']) && request.resource.data.c is map && request.resource.data.c.size() <= 60;
    }
    // مكان السواق اللايف (live/{drv1} = {lat,lng,ts,trip,spd?}): السيرفر بس بيكتبه (من تطبيق التتبع)، واللوحة بتقراه للخريطة
    match /live/{id} {
      allow read:  if isAdmin() || perm('fl') || isViewer();
      allow write: if false;
    }
    // أسماء السواقين للشات (ddir/{drv1} = {n}): المستودع بيكتبها لوحده من تبويب السيارات (fleet.js)، والكل بيقراها
    match /ddir/{id} {
      allow read:  if isAdmin() || isStaff() || branchOn() || drvOn();
      allow create, update: if isAdmin() && id.matches('^drv[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 60;
      allow delete: if isAdmin();
    }

    // صور حسابات المستودع: ava/{email} = {ph: صورة jpeg صغيرة, ts}. كل واحد يرفع أو يشيل صورته هو بس
    match /ava/{em} {
      allow read:  if isOwner() || isStaff() || branchOn() || drvOn();
      allow create, update: if (isOwner() || isStaff()) && em == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['ph','ts'])
        && request.resource.data.ph is string && request.resource.data.ph.size() <= 80000
        && request.resource.data.ph.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.ts is number;
      allow delete: if isOwner() || (isStaff() && em == request.auth.token.email.lower());
    }

    // سجل "مين عمل إيه": كل حساب في المستودع بيكتب سطوره باسمه هو بس، ومحدش يعدّل أو يمسح. المالك بس اللي بيقرا
    match /log/{lid} {
      allow read: if isOwner() || isViewer();
      allow create: if (isOwner() || isStaff())
        && request.resource.data.keys().hasOnly(['e','n','op','c','id','t','k','s','x','ts'])
        && request.resource.data.e == request.auth.token.email.lower()
        && request.resource.data.n is string && request.resource.data.n.size() <= 60
        && request.resource.data.op in ['set','upd','del']
        && request.resource.data.c is string && request.resource.data.c.size() <= 30
        && request.resource.data.id is string && request.resource.data.id.size() <= 60
        && request.resource.data.t is string && request.resource.data.t.size() <= 100
        && request.resource.data.k is list && request.resource.data.k.size() <= 12
        && request.resource.data.s is string && request.resource.data.s.size() <= 20
        && (!('x' in request.resource.data) || request.resource.data.x is number)
        && request.resource.data.ts is number;
    }

    // الشات الخاص: dm/{code}__{email} = محادثة بين فرع واحد وشخص واحد من المستودع.
    // محدش غيرهم يقدر يقرا أو يكتب فيها، حتى المالك والمديرين (كل واحد ليه محادثاته هو بس).
    // 📷 رسالة صورة (الشات الخاص والجروبات): المصغّرة جوه الرسالة، والأصلية في img/{نفس الرقم}
    function imgOk(d) {
      return d.keys().hasAll(['img','w','h','th']) && !('v' in d) && d.img == 1
        && d.w is number && d.h is number && d.th is string && d.th.size() <= 120000
        && d.th.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && (!('t' in d) || (d.t is string && d.t.size() <= 1000));
    }
    function fullImgOk() {
      return request.resource.data.keys().hasOnly(['i']) && request.resource.data.i is string
        && request.resource.data.i.size() <= 1000000 && request.resource.data.i.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }
    match /dm/{cid} {
      function me() { return request.auth.token.email.lower(); }
      function chatWh() { return isAdmin() || perm('req') || perm('gm') || isViewer()
        || (isStaff() && exists(/databases/$(database)/documents/whdir/$(me())) && get(/databases/$(database)/documents/whdir/$(me())).data.get('w', false) == true); }// اللي المالك اختاره في "المستودع"// الإدارة (مدير التسويق وصاحب الشركة) بتكلّم الفروع كمان
      // الطرفين من اسم المحادثة نفسه
      function whIn() { return chatWh() && cid.matches('^[0-9]{3}__.+$') && cid.split('__')[1] == me(); }
      function brIn() { return branchOn() && cid.matches('^[0-9]{3}__.+$') && cid.split('__')[0] == myCode(); }
      function lastOk(by) {
        let l = request.resource.data.last;
        return l is map && l.keys().hasOnly(['by','n','t','ts','v']) && l.keys().hasAll(['by','n','t','ts','v'])
          && l.by == by && l.n is string && l.n.size() <= 60
          && l.t is string && l.t.size() <= 200 && l.ts is number && l.v is bool;
      }
      function brnOk(d) { return !('brn' in d) || (d.brn is string && d.brn.size() <= 40); }
      function whnOk(d) { return d.whn is string && d.whn.size() <= 60; }
      // أول رسالة في المحادثة (لو الفرع اللي بدأ: لازم الشخص يكون في قايمة المستودع)
      function newBy(by) {
        let d = request.resource.data;
        return d.br + '__' + d.wh == cid && brnOk(d) && whnOk(d) && lastOk(by)
          && ((by == 'br' && d.keys().hasOnly(['br','brn','wh','whn','last','lb','rb','nw']) && d.nw == 1 && d.lb is number && d.rb is number
               && (get(/databases/$(database)/documents/whdir/$(d.wh)).data.get('r', '') in ['owner','admin','req','gm','v']
                   || get(/databases/$(database)/documents/whdir/$(d.wh)).data.get('w', false) == true))
           || (by == 'wh' && d.keys().hasOnly(['br','brn','wh','whn','last','lw','rw','nb']) && d.nb == 1 && d.lw is number && d.rw is number));
      }
      // رسالة جديدة (العدّاد بيزيد واحد بالظبط) أو "قريت" (العدّاد بيرجع صفر). الطرفين (br, wh) مايتغيّروش
      function updBy(by) {
        let d = request.resource.data;
        let o = resource.data;
        let ch = d.diff(o).affectedKeys();
        return brnOk(d)
          && (!('last' in ch) || lastOk(by))
          && ((by == 'br' && ch.hasOnly(['brn','last','lb','rb','nw','nb'])
               && (!('nw' in ch) || d.nw == o.get('nw', 0) + 1)
               && (!('nb' in ch) || d.nb == 0)
               && (!('lb' in ch) || d.lb is number) && (!('rb' in ch) || d.rb is number))
           || (by == 'wh' && ch.hasOnly(['brn','whn','last','lw','rw','nb','nw']) && whnOk(d)
               && (!('nb' in ch) || d.nb == o.get('nb', 0) + 1)
               && (!('nw' in ch) || d.nw == 0)
               && (!('lw' in ch) || d.lw is number) && (!('rw' in ch) || d.rw is number)));
      }
      // ---- المحادثات الجديدة (نوفمبر 2026): السواقين، الموظفين مع بعض، والفروع مع بعض ----
      // dm/{طرف1}__{طرف2} مترتبين أبجدياً. الطرف = b-كود الفرع / d-رقم السواق / w-إيميل الشخص اللي في المستودع.
      // فرع مع المستودع بيفضل بالشكل القديم فوق ({كود}__{إيميل})، وسواق مع سواق ممنوع.
      // الملخّص: {ps:[الطرفين], nm:{طرف:اسمه}, last:{by:الطرف,n,t,ts,v}, l0/l1 = آخر رسالة من الطرف 0/1، r0/r1 = قرا لحد إمتى، n0/n1 = لسه ماقراش كام}
      function myP()  { return isBranch() ? 'b-' + myCode() : (isDriver() ? 'd-' + myDrv() : 'w-' + me()); }
      function pOn()  { return isBranch() ? branchOn() : (isDriver() ? drvOn() : (isOwner() || isStaff())); }// صاحب الشركة (المتابع) بقى في الشات
      function nps()  { return cid.split('__'); }
      function nNew() { return cid.matches('^[bdw]-.+__[bdw]-.+$') && nps().size() == 2 && nps()[0] < nps()[1]; }
      function nSide(){ return nps()[0] == myP() ? 0 : (nps()[1] == myP() ? 1 : -1); }
      function nIn()  { return nNew() && pOn() && nSide() >= 0; }
      function nPair(){
        let a = nps()[0]; let b = nps()[1];
        return !(a.matches('^d-.*') && b.matches('^d-.*')) && !(a.matches('^b-.*') && b.matches('^w-.*'));
      }
      // الطرف التاني لازم يكون موجود: فرع (بالكود)، سواق في ddir، أو شخص في whdir
      function okP(p) {
        return p.matches('^b-[0-9]{3}$')
          || (p.matches('^d-drv[0-9]{1,2}$') && exists(/databases/$(database)/documents/ddir/$(p.replace('^d-', ''))))
          || (p.matches('^w-.+@.+$') && exists(/databases/$(database)/documents/whdir/$(p.replace('^w-', ''))));
      }
      function nLast(l) {
        return l is map && l.keys().hasOnly(['by','n','t','ts','v']) && l.keys().hasAll(['by','n','t','ts','v'])
          && l.by == myP() && l.n is string && l.n.size() <= 60 && l.t is string && l.t.size() <= 200 && l.ts is number && l.v is bool;
      }
      function nCreate() {
        let d = request.resource.data; let s = nSide(); let o = 1 - s;
        return d.keys().hasOnly(['ps','nm','last','l0','l1','r0','r1','n0','n1'])
          && d.ps == nps() && d.nm is map && d.nm.keys().hasOnly(nps()) && nLast(d.last)
          && d.get('n' + string(o), 0) == 1 && d.get('n' + string(s), 0) == 0
          && !(('l' + string(o)) in d) && !(('r' + string(o)) in d);
      }
      function nUpdate() {
        let d = request.resource.data; let r = resource.data; let s = nSide(); let o = 1 - s;
        let ch = d.diff(r).affectedKeys();
        return ch.hasOnly(['last','nm','l0','l1','r0','r1','n0','n1'])
          && !(('l' + string(o)) in ch) && !(('r' + string(o)) in ch)
          && (!(('n' + string(o)) in ch) || d.get('n' + string(o), 0) == r.get('n' + string(o), 0) + 1)
          && (!(('n' + string(s)) in ch) || d.get('n' + string(s), 0) == 0)
          && (!('last' in ch) || nLast(d.last))
          && (!('nm' in ch) || (d.nm.keys().hasOnly(nps()) && d.nm.diff(r.nm).affectedKeys().hasOnly([myP()])));
      }

      // القراءة بالحقول (علشان الصفحات بتسأل "محادثاتي": wh == إيميلي، أو br == كود الفرع، أو ps فيها أنا)
      allow read:   if (chatWh() && resource.data.wh == me()) || (branchOn() && resource.data.br == myCode())
                    || (pOn() && myP() in resource.data.get('ps', []));
      allow create: if (brIn() && newBy('br')) || (whIn() && newBy('wh'))
                    || (nIn() && nPair() && okP(nps()[1 - nSide()]) && nCreate());
      allow update: if (brIn() && updBy('br')) || (whIn() && updBy('wh')) || (nIn() && nUpdate());
      allow delete: if isOwner();

      // الرسايل: نص (t) أو صوت (v + d = المدة بالثواني)، و rq = بخصوص أنهي طلب (اختياري).
      // محدش يعدّل رسالة بعد ما تتبعت، غير الطرف التاني يسجّل "اتقرت إمتى" (rd) مرة واحدة
      match /msgs/{mid} {
        function msgOk(by) {
          let d = request.resource.data;
          return d.keys().hasOnly(['by','n','t','v','d','ts','rq','img','w','h','th']) && d.keys().hasAll(['by','n','ts'])
            && d.by == by && d.n is string && d.n.size() <= 60 && d.ts is number
            && (!('rq' in d) || (d.rq is map && d.rq.keys().hasOnly(['id','no']) && d.rq.id is string && d.rq.id.size() <= 40 && d.rq.no is string && d.rq.no.size() <= 40))
            && ((d.keys().hasAll(['t']) && !('v' in d) && !('img' in d) && d.t is string && d.t.size() > 0 && d.t.size() <= 1000)
             || (d.keys().hasAll(['v','d']) && !('t' in d) && !('img' in d) && d.v == true && d.d is number && d.d > 0 && d.d <= 120)
             || imgOk(d));
        }
        function readBy(by) {
          return resource.data.by != by && !('rd' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rd'])
            && request.resource.data.rd is number;
        }
        allow read:   if whIn() || brIn() || nIn();
        allow create: if (brIn() && msgOk('br')) || (whIn() && msgOk('wh')) || (nIn() && msgOk(myP()));
        allow update: if (brIn() && readBy('br')) || (whIn() && readBy('wh')) || (nIn() && readBy(myP()));
        allow delete: if isOwner();
      }
      match /img/{mid} {
        allow read:   if whIn() || brIn() || nIn();
        allow create: if (whIn() || brIn() || nIn()) && fullImgOk();
        allow delete: if isOwner();
      }
      // الصوت نفسه (data URL صوت بس، أقصى حوالي 500 كيلو)
      match /aud/{mid} {
        allow read:   if whIn() || brIn() || nIn();
        allow create: if (whIn() || brIn() || nIn())
          && request.resource.data.keys().hasOnly(['a'])
          && request.resource.data.a is string && request.resource.data.a.size() <= 700000
          && request.resource.data.a.matches('data:audio/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=]+');
        allow delete: if isOwner();
      }
    }

    // 👥 الجروبات (bchat.js): المالك والمديرين بيعملوا الجروب ويختاروا الأعضاء (فروع/مستودع/سواقين).
    // grp/{gid} = {name, ms:[الأعضاء], ad:[مديرين الجروب], by, ts, last, u:{مفتاح:عدّاد}, r:{مفتاح:قرا لحد إمتى}, nm:{مفتاح:اسم}}
    // المفتاح = الطرف من غير رموز. الأعضاء بس يقروا ويكتبوا، ومحدش برّه الجروب يشوف حاجة (ولا المالك لو مش عضو)
    match /grp/{gid} {
      function gMe()  { return request.auth.token.email.lower(); }
      function gP()   { return isBranch() ? 'b-' + myCode() : (isDriver() ? 'd-' + myDrv() : 'w-' + gMe()); }
      function gOn()  { return isBranch() ? branchOn() : (isDriver() ? drvOn() : (isOwner() || isStaff())); }
      function gK()   { return gP().replace('[^A-Za-z0-9]', '_'); }
      function lastG(l) {
        return l is map && l.keys().hasOnly(['by','n','t','ts','v']) && l.by == gP()
          && l.n is string && l.n.size() <= 60 && l.t is string && l.t.size() <= 200 && l.ts is number && l.v is bool;
      }
      function shapeOk(d) {
        return d.keys().hasOnly(['name','ms','ad','by','ts','last','u','r','nm'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.ms is list && d.ms.size() >= 2 && d.ms.size() <= 80 && d.ad is list && d.ad.size() >= 1 && d.ad.size() <= 10
          && d.u is map && d.r is map && d.nm is map;
      }
      allow read:   if gOn() && gP() in resource.data.ms;
      allow create: if isAdmin() && shapeOk(request.resource.data) && request.resource.data.by == gP()
                    && gP() in request.resource.data.ms && gP() in request.resource.data.ad && lastG(request.resource.data.last);
      // مدير الجروب (أو المالك): الاسم والأعضاء. أي عضو: آخر رسالة والعدّادات وقريت لحد إمتى واسمه
      allow update: if gOn() && gP() in resource.data.ms && shapeOk(request.resource.data) && (
          ((isOwner() || (isAdmin() && gP() in resource.data.ad))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','ms','ad','last','u','r','nm']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','u','r','nm'])
            && (!('last' in request.resource.data.diff(resource.data).affectedKeys()) || lastG(request.resource.data.last))
            && request.resource.data.nm.diff(resource.data.nm).affectedKeys().hasOnly([gK()])
            && request.resource.data.r.diff(resource.data.r).affectedKeys().hasOnly([gK()])));
      allow delete: if isOwner() || (isAdmin() && gP() in resource.data.ad);
      function gMem() { return gOn() && gP() in get(/databases/$(database)/documents/grp/$(gid)).data.ms; }
      match /msgs/{mid} {
        allow read:   if gMem();
        allow create: if gMem() && request.resource.data.keys().hasOnly(['by','n','t','v','d','ts','rq','img','w','h','th'])
          && request.resource.data.by == gP() && request.resource.data.n is string && request.resource.data.n.size() <= 60 && request.resource.data.ts is number
          && !('rq' in request.resource.data)
          && ((request.resource.data.keys().hasAll(['t']) && !('v' in request.resource.data) && !('img' in request.resource.data) && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 1000)
            || (request.resource.data.keys().hasAll(['v','d']) && !('t' in request.resource.data) && !('img' in request.resource.data) && request.resource.data.v == true && request.resource.data.d is number && request.resource.data.d > 0 && request.resource.data.d <= 120)
            || imgOk(request.resource.data));
        allow delete: if isOwner();
      }
      match /aud/{mid} {
        allow read:   if gMem();
        allow create: if gMem() && request.resource.data.keys().hasOnly(['a']) && request.resource.data.a is string
          && request.resource.data.a.size() <= 700000 && request.resource.data.a.matches('data:audio/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=]+');
        allow delete: if isOwner();
      }
      match /img/{mid} {
        allow read:   if gMem();
        allow create: if gMem() && fullImgOk();
        allow delete: if isOwner();
      }
    }

    // أجهزة إشعارات الموبايل: كل جهاز بيسجّل نفسه باسم صاحبه بس (السيرفر بيقرا بصلاحياته الخاصة)
    // push/{role__token}: نفس الموبايل ممكن يتسجّل بأكتر من دور (مستودع + فرع على نفس الجهاز)
    match /push/{pid} {
      function okPush() {
        let d = request.resource.data;
        return d.keys().hasOnly(['role','key','email','ts','tok','dv','lg'])
          && (!('dv' in d) || d.dv in ['m','pc'])
          && (!('lg' in d) || d.lg == 'en')
          && d.email == request.auth.token.email && d.ts is number && d.key is string && d.key.size() <= 120
          && d.tok is string && d.tok.size() <= 400 && pid == d.role + '__' + d.tok
          && ((d.role == 'branch' && isBranch() && d.key == myCode())
            || (d.role == 'driver' && isDriver() && d.key == myDrv())
            || (d.role == 'staff' && !isBranch() && !isDriver() && d.key == request.auth.token.email));
      }
      allow create, update: if signedIn() && okPush();
      allow delete: if signedIn() && resource.data.email == request.auth.token.email;
      // المالك بيشوف أجهزة الإشعارات بتاعة المستودع (موبايل/كمبيوتر) في تبويب الموظفين
      allow read: if isOwner() && resource.data.role == 'staff';
    }

    // آخر نسخة احتياطية إمتى (meta/backup = {at, n})، ومسح الشات القديم اتعمل إمتى (meta/chatv2)،
    // واسم المالك وكنيته (meta/me = {n, k}): لمالك النظام بس
    // 📢 التعميمات (ann.js): المالك والمديرين بيبعتوا، والكل بيقرا (المستودع والفروع). rd = مين قرا (كل طرف بيكتب نفسه بس)
    match /ann/{id} {
      allow read: if isAdmin() || isStaff() || branchOn();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['t','by','n','ts'])
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 2000
        && request.resource.data.by == request.auth.token.email.lower()
        && request.resource.data.n is string && request.resource.data.n.size() <= 60 && request.resource.data.ts is number;
      allow delete: if isOwner() || isAdmin();// المالك والمديرين يمسحوا التعميم
      match /rd/{p} {
        allow read: if isAdmin() || isStaff() || branchOn();
        allow create: if request.resource.data.keys().hasOnly(['ts','n']) && request.resource.data.ts is number
          && request.resource.data.n is string && request.resource.data.n.size() <= 60
          && ((branchOn() && p == myCode()) || ((isAdmin() || isStaff()) && p == request.auth.token.email.lower()));
      }
    }
    // 🛒 النواقص: "اتعمل طلب شراء" للكود ده (short.js). المستودع (مدير/طلبات) بيكتب، والكل في المستودع بيقرا
    match /buy/{key} {
      allow read: if isAdmin() || perm('req') || isViewer();
      allow write: if (isAdmin() || perm('req')) && request.resource.data.keys().hasOnly(['k','c','z','at','by','n'])
        && request.resource.data.at is number && request.resource.data.by == request.auth.token.email.lower()
        && request.resource.data.k is string && request.resource.data.k.size() <= 40
        && request.resource.data.n is string && request.resource.data.n.size() <= 60;
    }
    // 📊 التقرير الأسبوعي: مين يوصله (المالك بس بيحدد)
    match /cfg/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if isOwner() && id == 'weekly' && request.resource.data.keys().hasOnly(['to'])
        && request.resource.data.to is list && request.resource.data.to.size() <= 20;
    }
    match /meta/{id} {
      allow read:  if isOwner();
      allow write: if isOwner() && (
        (id in ['backup','chatv2']
          && request.resource.data.keys().hasOnly(['at','n'])
          && request.resource.data.at is number && request.resource.data.n is number)
        || (id == 'me'
          && request.resource.data.keys().hasOnly(['n','k'])
          && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 60
          && request.resource.data.k is string && request.resource.data.k.size() <= 40));
    }

    // أي حاجة تانية ممنوعة
  }
}
